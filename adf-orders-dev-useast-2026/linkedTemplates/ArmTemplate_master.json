{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-orders-dev-useast-2026"
		},
		"ls_dl_orders_raw_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_dl_orders_raw'"
		},
		"ls_sqldb_orders_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sqldb_orders'"
		},
		"ls_st_orders_landing_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_st_orders_landing'"
		},
		"ls_dl_orders_raw_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlordersadf2026.dfs.core.windows.net/"
		},
		"ls_sqldb_orders_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlsrvr-orders-dev.database.windows.net"
		},
		"ls_sqldb_orders_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-orders-dev"
		},
		"ls_sqldb_orders_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sreekanth"
		},
		"tw_trigger_properties_pipeline1_parameters_pStart": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowStartTime"
		},
		"tw_trigger_properties_pipeline1_parameters_pEnd": {
			"type": "string",
			"defaultValue": "@trigger().outputs.windowEndTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-orders-dev-useast-2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_dl_orders_raw_accountKey": {
						"value": "[parameters('ls_dl_orders_raw_accountKey')]"
					},
					"ls_sqldb_orders_password": {
						"value": "[parameters('ls_sqldb_orders_password')]"
					},
					"ls_st_orders_landing_connectionString": {
						"value": "[parameters('ls_st_orders_landing_connectionString')]"
					},
					"ls_dl_orders_raw_properties_typeProperties_url": {
						"value": "[parameters('ls_dl_orders_raw_properties_typeProperties_url')]"
					},
					"ls_sqldb_orders_properties_typeProperties_server": {
						"value": "[parameters('ls_sqldb_orders_properties_typeProperties_server')]"
					},
					"ls_sqldb_orders_properties_typeProperties_database": {
						"value": "[parameters('ls_sqldb_orders_properties_typeProperties_database')]"
					},
					"ls_sqldb_orders_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqldb_orders_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-orders-dev-useast-2026_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"tw_trigger_properties_pipeline1_parameters_pStart": {
						"value": "[parameters('tw_trigger_properties_pipeline1_parameters_pStart')]"
					},
					"tw_trigger_properties_pipeline1_parameters_pEnd": {
						"value": "[parameters('tw_trigger_properties_pipeline1_parameters_pEnd')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-orders-dev-useast-2026_ArmTemplate_0')]"
			]
		},
		{
			"name": "adf-orders-dev-useast-2026_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-orders-dev-useast-2026_ArmTemplate_1')]"
			]
		}
	]
}